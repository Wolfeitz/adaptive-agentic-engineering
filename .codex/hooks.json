{
  "description": "Route native Codex file-edit events into AAE event rules.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=src python -m aae native-hook codex",
            "timeout": 30,
            "statusMessage": "Applying AAE event rules"
          }
        ]
      }
    ]
  }
}
