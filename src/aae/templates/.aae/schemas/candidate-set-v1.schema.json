{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aae.dev/schemas/candidate-set-v1.schema.json",
  "title": "AAE CandidateSet v1",
  "type": "object",
  "required": ["schema_version", "capability_demand_sha256", "registry_content_sha256", "candidate_limit", "shortlist_limit", "registry_skill_count", "eligible_skill_count", "metadata_candidate_count", "candidates", "candidate_set_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "capability_demand_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registry_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_limit": {"type": "integer", "minimum": 0},
    "shortlist_limit": {"type": "integer", "minimum": 0},
    "registry_skill_count": {"type": "integer", "minimum": 0},
    "eligible_skill_count": {"type": "integer", "minimum": 0},
    "metadata_candidate_count": {"type": "integer", "minimum": 0},
    "candidates": {"type": "array", "items": {"type": "object", "required": ["registry_id", "skill_content_sha256", "score"]}},
    "candidate_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
