{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aae.dev/schemas/skill-policy-v1.schema.json",
  "title": "AAE Skill Invocation Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "minimum_trust", "required_source_approval", "allow_advisory_contracts", "allowed_side_effects", "approval_required_for", "allowed_tools", "network_allowed", "allowed_data_classifications", "model_authorizations"],
  "properties": {
    "schema_version": {"const": 1},
    "minimum_trust": {"enum": ["untrusted", "declared", "governed"]},
    "required_source_approval": {"enum": ["pending", "approved", "rejected"]},
    "allow_advisory_contracts": {"type": "boolean"},
    "allowed_side_effects": {"type": "array", "items": {"enum": ["read-only", "workspace-write", "external-write", "destructive"]}},
    "approval_required_for": {"type": "array", "items": {"enum": ["read-only", "workspace-write", "external-write", "destructive"]}},
    "allowed_tools": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "network_allowed": {"type": "boolean"},
    "allowed_data_classifications": {"type": "array", "items": {"enum": ["public", "internal", "controlled", "restricted"]}},
    "model_authorizations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "models", "capabilities", "data_classifications"],
        "properties": {
          "provider": {"type": "string", "minLength": 1},
          "models": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "data_classifications": {"type": "array", "items": {"enum": ["public", "internal", "controlled", "restricted"]}}
        }
      }
    },
    "require_verified_signature": {"type": "boolean"}
  }
}
