{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aae.dev/schemas/invocation-plan-v1.schema.json",
  "title": "AAE InvocationPlan v1",
  "type": "object",
  "required": ["schema_version", "registry_content_sha256", "capability_demand_sha256", "candidate_set_sha256", "selection_decision_sha256", "skill", "binding", "policy", "invocation_plan_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "registry_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capability_demand_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selection_decision_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "skill": {"type": ["object", "null"]},
    "binding": {"type": ["object", "null"]},
    "policy": {
      "type": "object",
      "required": ["policy_content_sha256", "decision", "checks", "rejection_reasons"],
      "properties": {
        "policy_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "decision": {"enum": ["allowed", "denied"]},
        "checks": {"type": "array", "items": {"type": "object"}},
        "rejection_reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "invocation_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
