{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aae.dev/schemas/capability-demand-v1.schema.json",
  "title": "AAE CapabilityDemand v1",
  "type": "object",
  "required": ["schema_version", "task", "required_capabilities", "architecture_surfaces", "environment_constraints", "risks", "evidence_gaps", "provenance", "capability_demand_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "task": {"type": "string"},
    "task_id": {"type": ["string", "null"]},
    "spec_id": {"type": ["string", "null"]},
    "required_capabilities": {"type": "array", "items": {"type": "string"}},
    "architecture_surfaces": {"type": "array", "items": {"type": "string"}},
    "environment_constraints": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "evidence_gaps": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "object"}}},
    "capability_demand_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
