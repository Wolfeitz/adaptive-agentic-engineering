{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aae.dev/schemas/hook-config-v1.schema.json",
  "title": "AAE Hooks v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "on"],
        "properties": {
          "id": {"type": "string"},
          "enabled": {"type": "boolean"},
          "on": {"type": "string"},
          "paths": {"type": "array", "items": {"type": "string"}},
          "request_skill": {"type": "string"},
          "run_check": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "task": {"type": "string"},
          "destructive": {"type": "boolean"},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
        },
        "oneOf": [
          {"required": ["request_skill"], "not": {"required": ["run_check"]}},
          {"required": ["run_check"], "not": {"required": ["request_skill"]}}
        ]
      }
    }
  }
}
