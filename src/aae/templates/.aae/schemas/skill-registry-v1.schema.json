{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aae.dev/schemas/skill-registry-v1.schema.json",
  "title": "AAE Skill Registry v1",
  "type": "object",
  "required": ["schema_version", "runtime_instance", "source_count", "skill_count", "capabilities", "sources", "skills", "registry_content_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "project_root": {"type": "string"},
    "runtime_instance": {"type": "object", "required": ["runtime_instance_id"]},
    "source_count": {"type": "integer", "minimum": 0},
    "skill_count": {"type": "integer", "minimum": 0},
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "items": {"type": "object"}},
    "skills": {"type": "array", "items": {"type": "object", "required": ["registry_id", "skill_content_sha256", "procedure_sha256"]}},
    "registry_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
