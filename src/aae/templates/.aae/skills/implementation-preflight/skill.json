{
  "schema_version": 1,
  "name": "implementation-preflight",
  "version": "0.1.0",
  "description": "Verify authority, scope, architecture precedent, dependency choices, impact, testing intent, and runtime ownership before editing.",
  "capabilities": ["implementation-readiness", "pattern-reuse-analysis", "change-impact-analysis", "dependency-selection"],
  "triggers": ["meaningful code change", "new dependency", "cross-boundary change", "shared infrastructure"],
